# Model as provider:model. Providers: groq | openrouter | gemini
LLM_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=            # free: https://console.groq.com/keys
OPENROUTER_API_KEY=      # free models: https://openrouter.ai/keys
GOOGLE_API_KEY=          # free tier: https://aistudio.google.com/apikey
MAX_TOKENS=2048

# fixtures = frozen demo week, no Razorpay account needed (used by evals and CI)
# razorpay = your Razorpay TEST account through the official MCP server
DATA_SOURCE=fixtures

# Razorpay test-mode keys: Dashboard -> switch to Test Mode -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp

# Guardrail: the copilot refuses to draft refunds above this; bigger ones go through the dashboard.
MAX_REFUND_INR=25000

# Optional: Langfuse tracing (https://cloud.langfuse.com, free Hobby plan)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: where `copilot digest --send` posts (Slack, Discord or Google Chat incoming webhook)
DIGEST_WEBHOOK_URL=

# Optional: pin "now" (ISO 8601). Fixtures mode pins it to the dataset's week automatically.
# COPILOT_NOW=2026-10-28T21:00:00+05:30
